# Template for deployment/pbs.env on the deploy machine.
#
# Copy to deployment/pbs.env there and fill in the real values. That file is gitignored and must never be
# committed — this repository is public.
#
#   cp deployment/pbs.env.example deployment/pbs.env
#   chmod 600 deployment/pbs.env
#
# Values are read once at startup: a change here needs a restart, not just a file save.

# --- Google OAuth2 (read from phase 3) ---
# pbs's own OAuth client, not the commuter app's — each can then be revoked alone.
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=

# --- The single Google account admitted (read from phase 3) ---
export PBS_ALLOWED_EMAIL=

# --- Claude API (read from phase 4) ---
# pbs's own key, ideally in its own Console workspace with a spending limit: the parse endpoint is the only one
# on the internet that costs money per call.
export ANTHROPIC_API_KEY=

# --- JVM tuning (optional) ---
# Defaults to -Xmx512m in start-pbs.sh.
# export JAVA_OPTS="-Xmx512m"

# Template for local-secrets.properties, read by the `local` profile (see application-local.properties).
#
# Copy to local-secrets.properties in the project root and fill in the real values. That file is gitignored and
# must never be committed — this repository is public.
#
#   cp local-secrets.properties.example local-secrets.properties
#
# The names are those of deployment/pbs.env: application.properties reads ${GOOGLE_CLIENT_ID} and the others,
# and a placeholder resolves from a properties file just as from the environment.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PBS_ALLOWED_EMAIL=
# Only with pbs.receipt-parser=claude (application-local.properties). pbs's own key — see Environment variables in
# CLAUDE.md.
ANTHROPIC_API_KEY=
